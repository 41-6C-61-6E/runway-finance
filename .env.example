# ─── Next Auth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
NEXTAUTH_SECRET=<64-char-hex>
NEXTAUTH_URL=http://localhost:3001

# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=personal_finance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personal_finance

# ─── Encryption ──────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<64-char-hex-string>

# ─── Registration Control ────────────────────────────────────────────────────
# Set to "false" after the first user registers
ALLOW_REGISTRATION=true
# Registration PIN — set to require a PIN for new account creation (leave empty to disable)
REGISTRATION_PIN=

# ─── FRED API (optional — for historical home price estimation) ───────────────
# Get a free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# ─── RentCast API (optional — for real estate property valuation) ─────────────
# RENTCAST_API_KEY=

# ─── Bug & Feature Reporting (optional) ───────────────────────────────────────
# Enable collaborative bug reporting and feature tracking dropdown
BUG_REPORTING=false


# ─── OAuth (optional — remove if not using) ───────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Web Push Notifications (optional) ────────────────────────────────────────
# Generate using: pnpm run generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@example.com"

# ─── Database Pool & Timeouts (optional) ──────────────────────────────────────
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=60000

# ─── Search Cache (optional) ──────────────────────────────────────────────────
# SEARCH_CACHE_TTL_MS=1800000
# SEARCH_CACHE_MAX_USERS=5

# ─── Startup Background Recalculation (optional) ──────────────────────────────
# RECALCULATE_ON_STARTUP=false

# ─── File Logging (optional) ──────────────────────────────────────────────────
# LOG_FILE_PATH=
# LOG_FILE_MAX_SIZE_MB=100
# LOG_FILE_MAX_FILES=20