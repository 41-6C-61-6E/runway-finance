# ─── Next Auth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
NEXTAUTH_SECRET=<64-char-hex>
NEXTAUTH_URL=http://localhost:3001

# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=personal_finance
# L-12 (2026-08-27 security review): do NOT copy `postgres:postgres` —
# use a strong, unique password you generated locally and set it in .env.
DATABASE_URL=postgresql://postgres:<strong-local-password>@localhost:5432/personal_finance

# ─── Encryption ──────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<64-char-hex-string>

# ─── Registration Control ────────────────────────────────────────────────────
# Set to "false" after the first user registers
# M-3: Registration is CLOSED BY DEFAULT. Set to true only to open up
# standalone (non-sharing) signups. Sharing joins via invitation tokens are
# NOT affected by this flag.
ALLOW_REGISTRATION=false
# Registration PIN — set to require a PIN for new account creation (leave empty to disable)
# M-3: optional PIN required for standalone registration (when
# ALLOW_REGISTRATION=true). Must be >= 8 characters and not a single
# repeated character, otherwise registration is refused.
REGISTRATION_PIN=

# ─── FRED API (optional — for historical home price estimation) ───────────────
# Get a free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# ─── RentCast API (optional — for real estate property valuation) ─────────────
# RENTCAST_API_KEY=

# ─── Bug & Feature Reporting (optional) ───────────────────────────────────────
# Enable collaborative bug reporting and feature tracking dropdown
BUG_REPORTING=false


# ─── OAuth (optional — remove if not using) ───────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Web Push Notifications (optional) ────────────────────────────────────────
# Generate using: pnpm run generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@example.com"

# ─── Database Pool & Timeouts (optional) ──────────────────────────────────────
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=60000

# ─── Search Cache (optional) ──────────────────────────────────────────────────
# SEARCH_CACHE_TTL_MS=1800000
# SEARCH_CACHE_MAX_USERS=5

# ─── Startup Background Recalculation (optional) ──────────────────────────────
# RECALCULATE_ON_STARTUP=false

# ─── File Logging (optional) ──────────────────────────────────────────────────
# LOG_FILE_PATH=
# LOG_FILE_MAX_SIZE_MB=100
# LOG_FILE_MAX_FILES=20

# ─── Rate limiting / IP trust ─────────────────────────────────────────────────
# Set to `true` ONLY if a reverse proxy fronts the app AND rewrites X-Real-IP
# to the real peer address AND strips client-supplied X-Forwarded-For before
# forwarding. Otherwise keep unset/false: the app then buckets direct
# connections under a shared identity so clients cannot rotate fake IPs to
# bypass rate limits (2026-08-27 security review, finding H-1).
# RATE_LIMIT_TRUST_PROXY=false