enable-pre-post-scripts=true
# L-16 (2026-08-27 security review): do NOT re-enable arbitrary dependency
# install scripts. pnpm 10 blocks dependency build scripts by default and
# only runs the curated allow-list (esbuild/sharp/etc. via its own
# mechanism). If a package genuinely needs a build step, allow it
# explicitly and individually in package.json `pnpm.onlyBuiltDependencies`
# after review — never blanket `ignore-scripts=false`.
prefer-latest=true

